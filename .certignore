# Additional path exclusions for xtask test certification.
# One rule per line:
# - "*.ext"  -> ignore by extension
# - "dir/"   -> ignore by repo-root prefix
# - "path"   -> ignore exact repo-root relative path
#
# Default exclusions are built-in and do not need to be listed here:
# - tests/certs/
# - *.md

# CI workflow files do not change verifier behavior or test expectations.
.github/workflows/

# Assistant/editor metadata is not a test input.
.claude/

# License-checker tooling input only.
.check-license.ignore

# Container image recipe does not affect local test execution.
Dockerfile
